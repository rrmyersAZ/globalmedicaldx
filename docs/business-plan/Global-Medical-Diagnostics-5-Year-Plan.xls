 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>Global Medical Diagnostics 5-Year Plan</Title>
  <Author>Global Medical Diagnostics</Author>
  <Created>2026-08-01T00:00:00Z</Created>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Font ss:FontName="Calibri" ss:Size="11"/>
  </Style>
  <Style ss:ID="Header">
   <Font ss:FontName="Calibri" ss:Size="14" ss:Bold="1"/>
  </Style>
  <Style ss:ID="SubHeader">
   <Font ss:FontName="Calibri" ss:Size="12" ss:Bold="1"/>
  </Style>
  <Style ss:ID="ColHeader">
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1F4E79" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Currency">
   <NumberFormat ss:Format="&quot;$&quot;#,##0"/>
  </Style>
  <Style ss:ID="CurrencyDec">
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
  </Style>
  <Style ss:ID="Number">
   <NumberFormat ss:Format="#,##0"/>
  </Style>
  <Style ss:ID="Pct">
   <NumberFormat ss:Format="0%"/>
  </Style>
  <Style ss:ID="Total">
   <Font ss:Bold="1"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0"/>
   <Interior ss:Color="#D6EAF8" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="TotalNum">
   <Font ss:Bold="1"/>
   <NumberFormat ss:Format="#,##0"/>
   <Interior ss:Color="#D6EAF8" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Net">
   <Font ss:Bold="1"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0"/>
   <Interior ss:Color="#D5F5E3" ss:Pattern="Solid"/>
  </Style>
 </Styles>

